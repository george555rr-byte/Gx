<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#07070e">
  <LinearLayout
      android:orientation="vertical"
      android:padding="16dp"
      android:layout_width="match_parent"
      android:layout_height="wrap_content">
    <TextView
        android:text="GX.TXT.U"
        android:textColor="#ffd700"
        android:textSize="26sp"
        android:textStyle="bold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <TextView
        android:text="Virtual Camera Studio"
        android:textColor="#666666"
        android:textSize="12sp"
        android:layout_marginBottom="16dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
      <Button android:id="@+id/slot1" android:text="Slot 1" android:layout_weight="1"
          android:layout_width="0dp" android:layout_height="wrap_content"/>
      <Button android:id="@+id/slot2" android:text="Slot 2" android:layout_weight="1"
          android:layout_width="0dp" android:layout_height="wrap_content"/>
      <Button android:id="@+id/slot3" android:text="Slot 3" android:layout_weight="1"
          android:layout_width="0dp" android:layout_height="wrap_content"/>
    </LinearLayout>
    <Button android:id="@+id/pickVideo" android:text="Pick Video"
        android:layout_marginTop="12dp"
        android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <Button android:id="@+id/pickImage" android:text="Pick Image"
        android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <Button android:id="@+id/startBtn" android:text="START"
        android:layout_marginTop="12dp"
        android:layout_width="match_parent" android:layout_height="wrap_content"/>
  </LinearLayout>
</ScrollView>
