<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gx_bg"
    android:fillViewport="true">

  <LinearLayout
      android:orientation="vertical"
      android:padding="16dp"
      android:layout_width="match_parent"
      android:layout_height="wrap_content">

    <LinearLayout
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
      <TextView
          android:text="SETTINGS"
          android:textColor="@color/gx_purple"
          android:textSize="22sp"
          android:textStyle="bold"
          android:letterSpacing="0.08"
          android:layout_weight="1"
          android:layout_width="0dp"
          android:layout_height="wrap_content"/>
      <Button android:id="@+id/backBtn" android:text="BACK"
          android:textColor="@color/gx_text" android:textAllCaps="false"
          android:textSize="11sp" android:stateListAnimator="@null"
          android:background="@drawable/btn_ghost"
          android:layout_width="wrap_content" android:layout_height="40dp"/>
    </LinearLayout>

    <TextView
        android:text="STEALTH"
        android:textColor="@color/gx_muted"
        android:textSize="11sp"
        android:textStyle="bold"
        android:letterSpacing="0.18"
        android:layout_marginTop="20dp" android:layout_marginBottom="8dp"
        android:layout_width="wrap_content" android:layout_height="wrap_content"/>

    <LinearLayout android:orientation="horizontal" android:gravity="center_vertical"
        android:padding="14dp" android:layout_marginBottom="6dp"
        android:background="@drawable/card"
        android:layout_width="match_parent" android:layout_height="wrap_content">
      <LinearLayout android:orientation="vertical" android:layout_weight="1"
          android:layout_width="0dp" android:layout_height="wrap_content">
        <TextView android:text="Hide from other apps"
            android:textColor="@color/gx_text" android:textSize="13sp"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <TextView android:text="Conceal module from detection"
            android:textColor="@color/gx_muted" android:textSize="10sp"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
      </LinearLayout>
      <Switch android:id="@+id/swHide" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    </LinearLayout>

    <LinearLayout android:orientation="horizontal" android:gravity="center_vertical"
        android:padding="14dp" android:layout_marginBottom="6dp"
        android:background="@drawable/card"
        android:layout_width="match_parent" android:layout_height="wrap_content">
      <LinearLayout android:orientation="vertical" android:layout_weight="1"
          android:layout_width="0dp" android:layout_height="wrap_content">
        <TextView android:text="Spoof metadata"
            android:textColor="@color/gx_text" android:textSize="13sp"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <TextView android:text="Report realistic camera parameters"
            android:textColor="@color/gx_muted" android:textSize="10sp"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
      </LinearLayout>
      <Switch android:id="@+id/swSpoof" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    </LinearLayout>

    <LinearLayout android:orientation="horizontal" android:gravity="center_vertical"
        android:padding="14dp" android:layout_marginBottom="6dp"
        android:background="@drawable/card"
        android:layout_width="match_parent" android:layout_height="wrap_content">
      <LinearLayout android:orientation="vertical" android:layout_weight="1"
          android:layout_width="0dp" android:layout_height="wrap_content">
        <TextView android:text="Fake EXIF"
            android:textColor="@color/gx_text" android:textSize="13sp"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <TextView android:text="Rewrite captured photo metadata"
            android:textColor="@color/gx_muted" android:textSize="10sp"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
      </LinearLayout>
      <Switch android:id="@+id/swExif" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    </LinearLayout>

    <LinearLayout android:orientation="horizontal" android:gravity="center_vertical"
        android:padding="14dp" android:layout_marginBottom="6dp"
        android:background="@drawable/card"
        android:layout_width="match_parent" android:layout_height="wrap_content">
      <LinearLayout android:orientation="vertical" android:layout_weight="1"
          android:layout_width="0dp" android:layout_height="wrap_content">
        <TextView android:text="Bypass root detection"
            android:textColor="@color/gx_text" android:textSize="13sp"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <TextView android:text="Hide root traces from target"
            android:textColor="@color/gx_muted" android:textSize="10sp"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
      </LinearLayout>
      <Switch android:id="@+id/swRoot" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    </LinearLayout>

    <LinearLayout android:orientation="horizontal" android:gravity="center_vertical"
        android:padding="14dp" android:layout_marginBottom="6dp"
        android:background="@drawable/card"
        android:layout_width="match_parent" android:layout_height="wrap_content">
      <LinearLayout android:orientation="vertical" android:layout_weight="1"
          android:layout_width="0dp" android:layout_height="wrap_content">
        <TextView android:text="Bypass emulator detection"
            android:textColor="@color/gx_text" android:textSize="13sp"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <TextView android:text="Mask emulator indicators"
            android:textColor="@color/gx_muted" android:textSize="10sp"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
      </LinearLayout>
      <Switch android:id="@+id/swEmu" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    </LinearLayout>

    <TextView
        android:text="INJECTION"
        android:textColor="@color/gx_muted"
        android:textSize="11sp"
        android:textStyle="bold"
        android:letterSpacing="0.18"
        android:layout_marginTop="18dp" android:layout_marginBottom="8dp"
        android:layout_width="wrap_content" android:layout_height="wrap_content"/>

    <LinearLayout android:orientation="horizontal" android:gravity="center_vertical"
        android:padding="14dp" android:layout_marginBottom="6dp"
        android:background="@drawable/card"
        android:layout_width="match_parent" android:layout_height="wrap_content">
      <LinearLayout android:orientation="vertical" android:layout_weight="1"
          android:layout_width="0dp" android:layout_height="wrap_content">
        <TextView android:text="Play sound"
            android:textColor="@color/gx_text" android:textSize="13sp"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <TextView android:text="Route video audio to target"
            android:textColor="@color/gx_muted" android:textSize="10sp"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
      </LinearLayout>
      <Switch android:id="@+id/swSound" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    </LinearLayout>

    <LinearLayout android:orientation="horizontal" android:gravity="center_vertical"
        android:padding="14dp" android:layout_marginBottom="6dp"
        android:background="@drawable/card"
        android:layout_width="match_parent" android:layout_height="wrap_content">
      <LinearLayout android:orientation="vertical" android:layout_weight="1"
          android:layout_width="0dp" android:layout_height="wrap_content">
        <TextView android:text="Mirror horizontally"
            android:textColor="@color/gx_text" android:textSize="13sp"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <TextView android:text="Flip front camera output"
            android:textColor="@color/gx_muted" android:textSize="10sp"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
      </LinearLayout>
      <Switch android:id="@+id/swMirror" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    </LinearLayout>

    <LinearLayout android:orientation="horizontal" android:gravity="center_vertical"
        android:padding="14dp" android:layout_marginBottom="6dp"
        android:background="@drawable/card"
        android:layout_width="match_parent" android:layout_height="wrap_content">
      <LinearLayout android:orientation="vertical" android:layout_weight="1"
          android:layout_width="0dp" android:layout_height="wrap_content">
        <TextView android:text="Auto position adjust"
            android:textColor="@color/gx_text" android:textSize="13sp"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <TextView android:text="Fit media to requested resolution"
            android:textColor="@color/gx_muted" android:textSize="10sp"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
      </LinearLayout>
      <Switch android:id="@+id/swAutoPos" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    </LinearLayout>

    <TextView
        android:text="GX · configuration layer"
        android:textColor="@color/gx_muted"
        android:textSize="10sp"
        android:gravity="center"
        android:layout_marginTop="18dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

  </LinearLayout>
</ScrollView>
